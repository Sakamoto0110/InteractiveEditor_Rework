<Project Sdk="Microsoft.NET.Sdk">

  <!-- The core builds and runs anywhere. Each UI framework has its own project next to it
       (PixieInspector.WinForms, .Wpf, .Avalonia and .ImGui), so the core depends on none of them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The package; Directory.Build.props holds the Version and what the five packages share. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>A reflection-based object inspector for .NET: point it at a type, bind one or more objects, and it builds a tree of the members, reads and writes them, and reports what it could not do. The core knows no UI framework; a view package shows the tree and edits it.</Description>
    <PackageTags>inspector;property-grid;reflection;editor</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- PixieLib from nuget.org. The adapters and the hosts get PixieLib through this reference. -->
    <PackageReference Include="PixieLib" Version="0.2.0" />
  </ItemGroup>

  <!-- The views were part of the core until the adapters had projects of their own, and they still
       use what the views of every framework decide the same way (ViewRules), which is not public API
       until a view from outside needs it (P7.21). -->
  <ItemGroup>
    <InternalsVisibleTo Include="PixieInspector.WinForms" />
    <InternalsVisibleTo Include="PixieInspector.Wpf" />
    <InternalsVisibleTo Include="PixieInspector.Avalonia" />
    <InternalsVisibleTo Include="PixieInspector.ImGui" />
  </ItemGroup>

</Project>
