<Project Sdk="Microsoft.NET.Sdk">

  <!-- The core builds and runs anywhere. Each UI framework has its own project next to it
       (PixieInspector.WinForms, .Wpf, .Avalonia and .ImGui), so the core depends on none of them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- PixieLib from nuget.org. The adapters and the hosts get PixieLib through this reference. -->
    <PackageReference Include="PixieLib" Version="0.1.0" />
  </ItemGroup>

  <!-- The views were part of the core until the adapters had projects of their own, and they still
       use what the views of every framework decide the same way (ViewRules), which is not public API
       until a view from outside needs it (P7.21). -->
  <ItemGroup>
    <InternalsVisibleTo Include="PixieInspector.WinForms" />
    <InternalsVisibleTo Include="PixieInspector.Wpf" />
    <InternalsVisibleTo Include="PixieInspector.Avalonia" />
    <InternalsVisibleTo Include="PixieInspector.ImGui" />
  </ItemGroup>

</Project>
