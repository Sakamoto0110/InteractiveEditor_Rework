<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ImGui.InputScalar and SliderScalar edit values in place through pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>The Dear ImGui view of PixieInspector, on Hexa.NET.ImGui: draws an inspector as a two-column table inside the host's ImGui frame. The host must use the same ImGui binding and version.</Description>
    <PackageTags>inspector;property-grid;imgui;dear-imgui</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PixieInspector\PixieInspector.csproj" />
  </ItemGroup>

</Project>
