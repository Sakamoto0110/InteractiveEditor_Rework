<Project Sdk="Microsoft.NET.Sdk">

  <!-- The WPF view of the inspector (P7.2), and the conversions of the primitives with WPF types, as
       extensions (PixieLib 4.4). WinForms too, for the color dialog, which WPF does not have. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the solution build (not run) on Linux/macOS; ignored on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- WinForms adds System.Drawing and System.Windows.Forms to the implicit usings; taken out, each
       file says what it uses, as in the core. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InteractiveEditor\InteractiveEditor.csproj" />
  </ItemGroup>

</Project>
