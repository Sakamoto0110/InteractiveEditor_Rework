<Project>

  <!-- The packages: the core and the four views go to nuget.org together, at the one Version below.
       .github/workflows/publish.yml, started by hand on GitHub, packs them, pushes them, and tags the
       commit with v and the Version. A new release raises the Version here. Projects are not packages
       unless they say so (IsPackable), so the hosts and DemoObjects stay out. -->
  <PropertyGroup>
    <Version>0.2.1</Version>
    <IsPackable>false</IsPackable>
    <Authors>Rafael Sakamoto</Authors>
    <Copyright>Copyright (c) 2026 Rafael Sakamoto</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Sakamoto0110/PixieInspector</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Sakamoto0110/PixieInspector</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
